// Owning side (User owns Address)
@OneToOne(fetch = FetchType.LAZY)
@JoinColumn(name = "profile_id") owner
private UserProfile profile;
----------------------------------
// Non-owning side — no fetch type (it's ignored anyway)
@OneToOne(mappedBy = "profile",unique = true)
private User user;

2)
// Owning side — make it LAZY!
@ManyToOne
@JoinColumn(name = "user_id", nullable = false,fetch = FetchType.LAZY) owner
private User user;
-----------------------------------------------------------
// Non-owning side — default LAZY is good
@OneToMany(mappedBy = "user",  cascade = {CascadeType.PERSIST, CascadeType.MERGE}, orphanRemoval = true)
private List<Post> posts;

3)
@ManyToMany// ← LAZY by default
    @JoinTable(
        name = "user_roles",
        joinColumns = @JoinColumn(name = "user_id"),
        inverseJoinColumns = @JoinColumn(name = "role_id")
    ) owner
    private Set<Role> roles = new HashSet<>();
------------------------------------------------------------

@ManyToMany(mappedBy = "roles")// ← LAZY by default
